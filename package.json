{
  "name": "quark-mini",
  "version": "1.3.0",
  "private": true,
  "description": "夸克网盘极简桌面客户端（Tauri 2 + Rust）— 轻量高速的文件浏览、搜索、自研并发上传下载、传输任务管理与可选在线更新反馈",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "start": "node scripts/tauri.js dev",
    "build": "node scripts/tauri.js build",
    "check:js": "node scripts/check.js",
    "check": "node scripts/check.js && node scripts/rust.js check",
    "test": "node --test test/tauri*.test.js",
    "test:rust": "node scripts/rust.js test",
    "verify:native": "node scripts/native-smoke.js",
    "verify:all": "npm run check && npm run test:rust && npm test && npm run verify:native"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  }
}
